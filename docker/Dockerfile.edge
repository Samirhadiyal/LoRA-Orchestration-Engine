# Path: docker/Dockerfile.edge
# Phase 6E: CPU-Only Slim Edge Container for NeuroMesh Swarm Workers

# Stage 1: Builder
FROM python:3.10-slim as builder

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends gcc python3-dev && rm -rf /var/lib/apt/lists/*

# Install Python dependencies (ignoring heavy GPU/CUDA packages)
COPY requirements.txt .
RUN pip wheel --no-cache-dir --no-deps --wheel-dir /app/wheels -r requirements.txt

# Stage 2: Final Edge Image
FROM python:3.10-slim

WORKDIR /app
ENV NEUROMESH_MODE=edge
ENV PYTHONPATH=/app

# Copy built wheels from Stage 1
COPY --from=builder /app/wheels /wheels
COPY --from=builder /app/requirements.txt .

# Install packages from wheels
RUN pip install --no-cache /wheels/*

# Copy the actual application code
COPY ./app ./app

# Expose standard API port
EXPOSE 8000

# Run a lightweight FastAPI entrypoint (or worker loop)
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
